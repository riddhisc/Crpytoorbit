# Copy to .env for local overrides. The demo runs with zero secrets.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/orbit.db
# Required only when DEMO_MODE=false. Write endpoints then expect X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true to refresh missing dates from the CoinGecko free API. Demo stays deterministic when false.
PRICES_ONLINE=false
# Optional. Wallet live fetch is skipped when empty; upload the JSON export instead.
ETHERSCAN_API_KEY=
# Optional. Column mapping falls back to fuzzy matching when empty.
# Only header row + 5 sample rows are ever sent.
ANTHROPIC_API_KEY=
# Optional outbound webhook. Private IP ranges are rejected.
WEBHOOK_URL=
WEBHOOK_SECRET=
